SNOWFLAKE_ACCOUNT=nhc33680.us-east-1
SNOWFLAKE_USER=CENSUS_APP
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CENSUS_DB
SNOWFLAKE_SCHEMA=CENSUS_VIEWS
SNOWFLAKE_ROLE=CENSUS_READONLY

# LLM provider: "bedrock" (default, uses AWS creds — for Amazon-network runs)
# or "anthropic" (direct Anthropic API, only needs ANTHROPIC_API_KEY, no AWS).
# Flip to anthropic when deploying off the Amazon network (e.g. Render).
LLM_PROVIDER=bedrock

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Used only when LLM_PROVIDER=anthropic. Install the extra: pip install -e ".[anthropic]"
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096

CORS_ORIGINS=http://localhost:5173
# Shared secret guarding the /chat API. Leave empty for local dev (no auth).
# Set a long random value before exposing publicly, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
SESSION_DIR=./.sessions
LOG_LEVEL=INFO
MAX_ROW_LIMIT=10000
